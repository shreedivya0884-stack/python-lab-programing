   "source": [
    "from functools import reduce\n",
    "\n",
    "numbers = [12, 45, 67, 23, 89, 34]\n",
    "\n",
    "maximum = reduce(lambda x, y: x if x > y else y, numbers)\n",
    "\n",
    "print(\"List Elements:\", numbers)\n",
    "print(\"Maximum Element:\", maximum)"
   ]
